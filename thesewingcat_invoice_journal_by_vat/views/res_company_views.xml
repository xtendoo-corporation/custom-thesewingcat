<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_invoice_journal_by_vat" model="ir.ui.view">
        <field name="name">res.company.form.invoice.journal.by.vat</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="website_sale_invoice_journal_id"/>
                <field name="website_sale_invoice_journal_nif_id"/>
            </xpath>
        </field>
    </record>
</odoo>

