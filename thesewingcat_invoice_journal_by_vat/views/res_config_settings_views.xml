<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_invoice_journal_by_vat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.invoice.journal.by.vat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Website Sale Invoice Journals" name="website_sale_invoice_journals">
                    <setting string="Journal without NIF" help="Journal used when the customer does not have a VAT/NIF.">
                        <field name="website_sale_invoice_journal_id"/>
                    </setting>
                    <setting string="Journal with NIF" help="Journal used when the customer has a VAT/NIF.">
                        <field name="website_sale_invoice_journal_nif_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

