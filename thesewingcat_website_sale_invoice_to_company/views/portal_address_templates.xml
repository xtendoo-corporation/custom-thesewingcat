    <!-- Hide use_delivery_as_billing checkbox in my addresses page -->
    <template id="my_addresses_invoice_to_company" inherit_id="portal.my_addresses">
        <xpath expr="//div[@class='d-flex justify-content-between align-items-start gap-3 mt-4 pt-2']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//label[@id='use_delivery_as_billing_label']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
