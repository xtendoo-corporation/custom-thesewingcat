<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="website_sale_address_form_fields_invoice_to_company" inherit_id="website_sale.address_form_fields">
        <xpath expr="//input[@id='o_company_name']" position="attributes">
            <attribute name="t-att-required">'required' if invoice_to_company else None</attribute>
        </xpath>
        <xpath expr="//label[@for='o_company_name']" position="attributes">
            <attribute name="t-attf-class">col-form-label fw-normal#{'' if invoice_to_company else ' label-optional'}</attribute>
        </xpath>
        <xpath expr="//input[@id='o_vat']" position="attributes">
            <attribute name="t-att-required">'required' if invoice_to_company else None</attribute>
        </xpath>
        <xpath expr="//label[@for='o_vat']" position="attributes">
            <attribute name="t-attf-class">col-form-label fw-normal#{'' if invoice_to_company else ' label-optional'}</attribute>
        </xpath>
        <xpath expr="//div[@id='div_phone']" position="after">
            <div
                t-if="display_b2b_fields and is_used_as_billing"
                id="div_invoice_to_company"
                class="col-lg-12 mb-2"
            >
                <div class="form-check mt-1">
                    <input
                        id="o_invoice_to_company"
                        type="checkbox"
                        name="invoice_to_company"
                        value="1"
                        class="form-check-input"
                        t-att-checked="invoice_to_company"
                    />
                    <label class="form-check-label" for="o_invoice_to_company">Facturar a empresa</label>
                </div>
            </div>
        </xpath>
    </template>

